classDiagram
direction LR

%% Usuario vinculado a autenticación de Supabase
class Usuario {
  +uuid IdUsuario
  +string Correo
  +string Rol
}

Usuario ..> auth.users : Vinculado
note for Usuario "Autenticación manejada por Supabase"

%% Cliente vinculado a Usuario
class Cliente {
  +int IdCliente
  +string Nombre
  +string Correo
  +string Telefono
}

%% Categoría y Producto
class Categoria {
  +int IdCategoria
  +string Nombre
  +string Descripcion
  +bool Activo
}

class Producto {
  +int IdProducto
  +int IdCategoria_FK
  +string Nombre
  +string Marca
  +float Precio
  +int Stock
  +bool Activo
}

Categoria "1" --> "0..*" Producto : Clasifica

%% Productos en Carrito y Ventas
class Carrito {
  +int IdCarrito
  +int IdUsuario_FK
}

class DetalleCarrito {
  +int IdDetalleCarrito
  +int IdProducto_FK
  +int Cantidad
  +float Precio
}

Usuario "1" --> "0..1" Carrito : Tiene
Carrito "1" --> "1..*" DetalleCarrito : Contiene
Producto "1" --> "0..*" DetalleCarrito : Agregado

%% Ventas y Detalles de Venta
class Venta {
  +int IdVenta
  +uuid IdUsuario_FK
  +int IdCliente_FK
  +date Fecha
  +float Total
}

class DetalleVenta {
  +int IdDetalleVenta
  +int IdVenta_FK
  +int IdProducto_FK
  +int Cantidad
  +float Precio
}

Usuario "1" --> "0..*" Venta : Registra
Cliente "1" --> "0..*" Venta : Compra
Venta "1" --> "1..*" DetalleVenta : Contiene
Producto "1" --> "0..*" DetalleVenta : Vendido
classDiagram
direction LR

%% ===============================
%% USUARIO (SUPABASE AUTH)
%% ===============================
class Usuario {
  +uuid IdUsuario
  +string Correo
  +string Rol
}

Usuario ..> auth.users : Vinculado
note for Usuario "Autenticación manejada por Supabase"

%% ===============================
%% CLIENTE (VINCULADO A USUARIO)
%% ===============================
class Cliente {
  +int IdCliente
  +uuid IdUsuario_FK
  +string Nombre
  +string Telefono
}

Usuario "1" --> "0..1" Cliente : Es

%% ===============================
%% EMPLEADO (VINCULADO A USUARIO)
%% ===============================
class Empleado {
  +int IdEmpleado
  +uuid IdUsuario_FK
  +string Nombre
  +string Cargo
}

Usuario "1" --> "0..1" Empleado : Es

%% ===============================
%% CATEGORIA Y PRODUCTO
%% ===============================
class Categoria {
  +int IdCategoria
  +string Nombre
  +string Descripcion
  +bool Activo
}

class Producto {
  +int IdProducto
  +int IdCategoria_FK
  +string Nombre
  +string Marca
  +decimal Precio
  +int Stock
  +bool Activo
}

Categoria "1" --> "0..*" Producto : Clasifica

%% ===============================
%% CARRITO
%% ===============================
class Carrito {
  +int IdCarrito
  +uuid IdUsuario_FK
}

class DetalleCarrito {
  +int IdDetalleCarrito
  +int IdCarrito_FK
  +int IdProducto_FK
  +int Cantidad
  +decimal Precio
}

Usuario "1" --> "0..*" Carrito : Tiene
Carrito "1" --> "1..*" DetalleCarrito : Contiene
Producto "1" --> "0..*" DetalleCarrito : Agregado

%% ===============================
%% VENTAS
%% ===============================
class Venta {
  +int IdVenta
  +uuid IdUsuario_FK
  +int IdCliente_FK
  +date Fecha
  +decimal Total
}

class DetalleVenta {
  +int IdDetalleVenta
  +int IdVenta_FK
  +int IdProducto_FK
  +int Cantidad
  +decimal Precio
}

Usuario "1" --> "0..*" Venta : Registra
Cliente "1" --> "0..*" Venta : Compra
Venta "1" --> "1..*" DetalleVenta : Contiene
Producto "1" --> "0..*" DetalleVenta : Vendido